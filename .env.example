# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — used to save paid orders

# Paystack (Settings → API Keys & Webhooks)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=                # server only — used to verify payments

# Optional: newsletter sign-up endpoint (Formspree, etc.)
NEXT_PUBLIC_SUBSCRIBE_ENDPOINT=
